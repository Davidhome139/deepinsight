# ========================================
# Application Configuration
# ========================================

# Server Configuration
APP_SERVER_PORT=8080
APP_SERVER_MODE=debug
APP_SERVER_CORS_ORIGINS=[]

# Database Configuration (PostgreSQL)
APP_DATABASE_POSTGRES_HOST=db
APP_DATABASE_POSTGRES_PORT=5432
APP_DATABASE_POSTGRES_USER=postgres
APP_DATABASE_POSTGRES_PASSWORD=password
APP_DATABASE_POSTGRES_DBNAME=yuanbao
APP_DATABASE_POSTGRES_SSLMODE=disable
APP_DATABASE_POSTGRES_MAX_CONNECTIONS=0

# Database Configuration (Redis)
APP_DATABASE_REDIS_HOST=redis
APP_DATABASE_REDIS_PORT=6379
APP_DATABASE_REDIS_PASSWORD=
APP_DATABASE_REDIS_DB=0

# JWT Configuration
APP_JWT_SECRET=your-jwt-secret-key-here

# Cache Configuration
APP_CACHE_TTL_CONVERSATION=300
APP_CACHE_TTL_SESSION=3600
APP_CACHE_TTL_USER_SETTINGS=1800

# Storage Configuration
APP_STORAGE_UPLOAD_DIR=
APP_STORAGE_MAX_SIZE=0
APP_STORAGE_ALLOWED_TYPES=[]

# ========================================
# Models Configuration (MODELS_ prefix)
# ========================================

# Aliyun (Qwen) Provider
MODELS_PROVIDERS_ALIYUN_ENABLED=true
MODELS_PROVIDERS_ALIYUN_APIKEY=your-aliyun-api-key-here
MODELS_PROVIDERS_ALIYUN_BASEURL=https://dashscope.aliyuncs.com/compatible-mode/v1
MODELS_PROVIDERS_ALIYUN_ENDPOINT=/chat/completions
MODELS_PROVIDERS_ALIYUN_AUTHTYPE=bearer
MODELS_PROVIDERS_ALIYUN_TIMEOUT=60
MODELS_PROVIDERS_ALIYUN_ENABLETHINKING=false

# Baidu Provider
MODELS_PROVIDERS_BAIDU_ENABLED=true
MODELS_PROVIDERS_BAIDU_APIKEY=YOUR_BAIDU_ACCESS_TOKEN
MODELS_PROVIDERS_BAIDU_BASEURL=https://qianfan.baidubce.com
MODELS_PROVIDERS_BAIDU_ENDPOINT=/v2/chat/completions
MODELS_PROVIDERS_BAIDU_AUTHTYPE=bearer
MODELS_PROVIDERS_BAIDU_TIMEOUT=60

# DeepSeek Provider
MODELS_PROVIDERS_DEEPSEEK_ENABLED=true
MODELS_PROVIDERS_DEEPSEEK_APIKEY=your-deepseek-api-key-here
MODELS_PROVIDERS_DEEPSEEK_BASEURL=https://api.deepseek.com
MODELS_PROVIDERS_DEEPSEEK_ENDPOINT=/chat/completions
MODELS_PROVIDERS_DEEPSEEK_AUTHTYPE=bearer
MODELS_PROVIDERS_DEEPSEEK_TIMEOUT=60

# MiniMax Provider
MODELS_PROVIDERS_MINIMAX_ENABLED=true
MODELS_PROVIDERS_MINIMAX_APIKEY=your-minimax-api-key-here
MODELS_PROVIDERS_MINIMAX_BASEURL=https://api.minimaxi.com
MODELS_PROVIDERS_MINIMAX_ENDPOINT=/v1/text/chatcompletion_v2
MODELS_PROVIDERS_MINIMAX_AUTHTYPE=bearer
MODELS_PROVIDERS_MINIMAX_TIMEOUT=60
MODELS_PROVIDERS_MINIMAX_STREAM=true

# Tencent (Hunyuan) Provider
MODELS_PROVIDERS_TENCENT_ENABLED=true
MODELS_PROVIDERS_TENCENT_APIKEY=your-tencent-api-key-here
MODELS_PROVIDERS_TENCENT_BASEURL=https://api.hunyuan.cloud.tencent.com/v1
MODELS_PROVIDERS_TENCENT_ENDPOINT=/chat/completions
MODELS_PROVIDERS_TENCENT_AUTHTYPE=bearer
MODELS_PROVIDERS_TENCENT_TIMEOUT=60

# Tencent Cloud (TC3 Signature) Provider
MODELS_PROVIDERS_TENCENTCLOUD_ENABLED=true
MODELS_PROVIDERS_TENCENTCLOUD_APIKEY=your-api-key-here
MODELS_PROVIDERS_TENCENTCLOUD_SECRETKEY=your-secret-key-here
MODELS_PROVIDERS_TENCENTCLOUD_SECRETID=your-secret-id-here
MODELS_PROVIDERS_TENCENTCLOUD_BASEURL=https://hunyuan.tencentcloudapi.com
MODELS_PROVIDERS_TENCENTCLOUD_ENDPOINT=/v1/chat/completions
MODELS_PROVIDERS_TENCENTCLOUD_AUTHTYPE=tc3-hmac-sha256
MODELS_PROVIDERS_TENCENTCLOUD_TIMEOUT=60

# Claude (Anthropic) Provider
MODELS_PROVIDERS_CLAUDE_ENABLED=false
MODELS_PROVIDERS_CLAUDE_APIKEY=
MODELS_PROVIDERS_CLAUDE_BASEURL=
MODELS_PROVIDERS_CLAUDE_ENDPOINT=/v1/messages

# OpenAI Provider
MODELS_PROVIDERS_OPENAI_ENABLED=false
MODELS_PROVIDERS_OPENAI_APIKEY=
MODELS_PROVIDERS_OPENAI_BASEURL=
MODELS_PROVIDERS_OPENAI_ENDPOINT=/chat/completions

# Moonshot Provider
MODELS_PROVIDERS_MOONSHOT_ENABLED=false
MODELS_PROVIDERS_MOONSHOT_APIKEY=
MODELS_PROVIDERS_MOONSHOT_BASEURL=
MODELS_PROVIDERS_MOONSHOT_ENDPOINT=/chat/completions

# Doubao (ByteDance) Provider
MODELS_PROVIDERS_DOUBAO_ENABLED=false
MODELS_PROVIDERS_DOUBAO_APIKEY=
MODELS_PROVIDERS_DOUBAO_BASEURL=
MODELS_PROVIDERS_DOUBAO_ENDPOINT=/chat/completions

# Zhipu (ChatGLM) Provider
MODELS_PROVIDERS_ZHIPU_ENABLED=false
MODELS_PROVIDERS_ZHIPU_APIKEY=
MODELS_PROVIDERS_ZHIPU_BASEURL=
MODELS_PROVIDERS_ZHIPU_ENDPOINT=/chat/completions

# Models Global Settings
MODELS_SETTINGS_DEFAULTMODEL=
MODELS_SETTINGS_TIMEOUT=60
MODELS_SETTINGS_MAXTOKENS=0
MODELS_SETTINGS_TEMPERATURE=0.7
MODELS_SETTINGS_STREAM=true
MODELS_SETTINGS_RETRYTIMES=0
MODELS_SETTINGS_RETRYDELAY=0

# ========================================
# Search Configuration (SEARCHS_ prefix)
# ========================================

# Search Settings
SEARCHS_SETTINGS_DEFAULTPROVIDER=
SEARCHS_SETTINGS_TIMEOUT=60
SEARCHS_SETTINGS_MAXRESULTS=10
SEARCHS_SETTINGS_SAFESEARCH=true

# ========================================
# MCP Servers Configuration (MCPSERVERS_ prefix)
# ========================================

MCPSERVERS_SETTINGS_AUTO_DISCOVER=false
MCPSERVERS_SETTINGS_TIMEOUT=60
MCPSERVERS_SETTINGS_MAX_TOOLS=100

# ========================================
# Skills Configuration (SKILLS_ prefix)
# ========================================

SKILLS_SETTINGS_TTL=300000
SKILLS_SETTINGS_SUBAGENT_ENABLED=true

# ========================================
# Agents Configuration (AGENTS_ prefix)
# ========================================

AGENTS_SETTINGS_DEFAULT_AGENT=
AGENTS_SETTINGS_MAX_ITERATIONS=10
AGENTS_SETTINGS_AUTO_CONFIRM=false
AGENTS_SETTINGS_PARALLEL_EXECUTION=false

